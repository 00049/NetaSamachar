generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AISummary {
  id              String   @id @default(cuid())
  politicianId    String   @unique
  summary         String
  generatedAt     DateTime @default(now())
  lastDataUpdate  DateTime
  version         Int      @default(1)
  inputHash       String
  sourcesUsed     String   // Stored as JSON string
  confidenceScore Float
  status          String   // CURRENT, STALE, GENERATING, FAILED
}
